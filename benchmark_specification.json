    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "GPU"
  },
  {
    "field_name": "GPU Model",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "MI300X"
  },
  {
    "field_name": "Raw Output Format",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "CSV with two identical training-sample rows"
  },
  {
    "field_name": "Primary Record Granularity",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "one timed training step, written twice"
  },
  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,step,loss,images_per_sec,step_time_ms,achieved_TFLOPS,memory_bandwidth_GBps,modeled_param_input_traffic_gb_s,peak_gpu_memory_GB\n0,0,1.0,120,16.7,1.2,40,40,2.5"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --dataset-name synthetic --precision fp16 --image-size 64 --batch-size 2 --learning-rate 0.1 --warmup-iters 1 --num-iterations 3"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --dataset-name synthetic --precision fp16 --image-size 224 --batch-size 8 --learning-rate 0.1 --warmup-iters 2 --num-iterations 18000"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --dataset-name synthetic --precision fp16 --image-size 224 --batch-size 16 --learning-rate 0.1 --warmup-iters 5 --num-iterations 49000"
  },
  {
    "field_name": "Output Fields / Metrics to Parse",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "step_time_ms, images_per_sec, achieved_TFLOPS, memory_bandwidth_GBps, modeled_param_input_traffic_gb_s, peak_gpu_memory_GB"
  },
  {
    "field_name": "Success Criteria",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "The timed training loop finishes and images_per_sec and step_time_ms are finite and positive"
  },
  {
    "field_name": "Parser and Normalization Notes",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "loss is the constant 1.0. achieved_TFLOPS uses 3 * 2 * 3.8e9 * (image/224)^2 * images/s / 1e12. memory_bandwidth_GBps and modeled_param_input_traffic_gb_s are the same minimum-traffic model, (parameter bytes * 4 + activation bytes * 2) / step time. The two CSV rows are copies"
  },
