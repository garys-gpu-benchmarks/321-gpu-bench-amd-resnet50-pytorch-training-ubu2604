  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Measure mixed-precision ResNet-50 training-step efficiency"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates step_time_ms, images/s, and peak memory from an inline PyTorch trainer. This is not pytest"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: Training batch step time (step_time_ms); #2: Training throughput (images_per_sec); #3: Achieved TFLOPS, model-FLOPs estimate (achieved_TFLOPS); #4: Peak GPU memory usage (peak_gpu_memory_GB); #5: Modeled parameter and input traffic, GB/s (modeled_param_input_traffic_gb_s)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run inline torchvision.models.resnet50 training on synthetic tensors. Does not launch a separate train_resnet50.py twice"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run an in-process PyTorch ResNet-50 FP16 trainer (torchvision.models.resnet50) on synthetic images with yaml image_size, batch_size, and num_iterations, then write step_time_ms, images_per_sec, and peak memory, to measure mixed-precision training efficiency. This is one inline pass, not two subprocess trainers"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Train torchvision ResNet-50 in one inline FP16 pass on synthetic images for yaml image_size, batch_size, and num_iterations, then write step time, images per second, and peak memory. This is not two subprocess trainers"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Trains torchvision ResNet-50 in-process on synthetic images (one timed pass, not two subprocess trainers). image_size, batch_size, warmup_iters, num_iterations, precision (fp16 default), and learning_rate come from yaml. dataset_name is ignored. achieved_TFLOPS and memory_bandwidth_GBps are hardcoded 1.0. output_format: csv"
  },
  {
    "field_name": "Execution Domain",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "GPU Compute / ROCm"
  },
  {
    "field_name": "Workload Category",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Training, Inference, Model Workloads"
  },
  {
